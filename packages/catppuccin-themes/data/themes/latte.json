  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9ca0b0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.language"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "scope": ["entity", "entity.name"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "scope": ["storage.modifier.package", "storage.modifier.import", "storage.type.java"],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": ["string", "punctuation.definition.string", "string punctuation.section.embedded source"],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d20f39"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d20f39"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d20f39"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d20f39"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#eff1f5",
        "background": "#8839ef"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "scope": "string source",
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": ["source.regexp", "string.regexp"],
      "settings": {
        "foreground": "#ea76cb"
      }
    },
    {
      "scope": ["string.regexp.character-class", "string.regexp constant.character.escape", "string.regexp source.ruby.embedded", "string.regexp string.regexp.arbitrary-repitition"],
      "settings": {
        "foreground": "#ea76cb"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#40a02b"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": "markup.raw",
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "scope": ["markup.ignored", "markup.untracked"],
      "settings": {
        "foreground": "#e6e9ef"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "foreground": "#7287fd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": ["brackethighlighter.tag", "brackethighlighter.curly", "brackethighlighter.round", "brackethighlighter.square", "brackethighlighter.angle", "brackethighlighter.quote"],
      "settings": {
        "foreground": "#9ca0b0"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "scope": ["constant.other.reference.link", "string.other.link"],
      "settings": {
        "foreground": "#ea76cb",
        "fontStyle": "underline"
      }
    }
  ]
}
