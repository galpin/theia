  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6c7086",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.language"],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": ["entity", "entity.name"],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": ["storage.modifier.package", "storage.modifier.import", "storage.type.java"],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "scope": ["string", "punctuation.definition.string", "string punctuation.section.embedded source"],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f38ba8"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f38ba8"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f38ba8"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f38ba8"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#1e1e2e",
        "background": "#cba6f7"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "scope": "string source",
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": ["source.regexp", "string.regexp"],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "scope": ["string.regexp.character-class", "string.regexp constant.character.escape", "string.regexp source.ruby.embedded", "string.regexp string.regexp.arbitrary-repitition"],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a6e3a1"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#cdd6f4"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#cdd6f4"
      }
    },
    {
      "scope": "markup.raw",
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": ["markup.ignored", "markup.untracked"],
      "settings": {
        "foreground": "#181825"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "foreground": "#b4befe",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "scope": ["brackethighlighter.tag", "brackethighlighter.curly", "brackethighlighter.round", "brackethighlighter.square", "brackethighlighter.angle", "brackethighlighter.quote"],
      "settings": {
        "foreground": "#6c7086"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "scope": ["constant.other.reference.link", "string.other.link"],
      "settings": {
        "foreground": "#f5c2e7",
        "fontStyle": "underline"
      }
    }
  ]
}
